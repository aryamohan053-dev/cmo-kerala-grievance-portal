# ==============================================================================
# CM Kerala Public Grievance Redressal Portal - Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# JWT Cryptographic Secret (Replace with secure random key in production)
JWT_SECRET=kerala_cmo_secret_key_2026_super_secure

# Database Configuration (Defaults to embedded high-performance SQLite)
DATABASE_PATH=./grievance_portal.db

# AI Integration - Google Gemini API Key (Optional)
# If left blank or unset, the system runs its built-in contextual NLP heuristic engine with 100% offline functionality.
GEMINI_API_KEY=your_gemini_api_key_here

# Client URL (For CORS whitelist in distributed setups)
CLIENT_URL=http://localhost:5173
