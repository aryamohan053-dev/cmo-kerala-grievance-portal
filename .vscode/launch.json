{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run Full-Stack Portal (Port 5000)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/server/server.js",
      "cwd": "${workspaceFolder}/server"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run Automated Tests",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/server/tests/api.test.js",
      "cwd": "${workspaceFolder}/server"
    }
  ]
}
